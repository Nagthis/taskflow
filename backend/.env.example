PORT=4000

# --- Desarrollo local ---
# Variables sueltas para el Postgres local (sin SSL).
PGHOST=localhost
PGPORT=5432
PGDATABASE=taskflow
PGUSER=taskflow
PGPASSWORD=taskflow_dev_pw

# --- Producción (Neon, Render, etc.) ---
# Si defines DATABASE_URL, tiene prioridad sobre las variables PG* de arriba
# y se conecta con SSL. Formato: postgresql://usuario:clave@host/db?sslmode=require
# DATABASE_URL=

JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=8h

# Uno o varios orígenes separados por coma, p. ej.:
# CORS_ORIGIN=http://localhost:5173,https://taskflow.vercel.app
CORS_ORIGIN=http://localhost:5173
